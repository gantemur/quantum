{
  "name": "quantum-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "playwright test",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3"
  }
}
